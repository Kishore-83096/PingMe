upstream pingme_backend {
    server ${BACKEND_HOST}:${BACKEND_PORT};
}

server {
    listen ${NGINX_PORT};

    location /api/ {
        proxy_pass ${BACKEND_URL};

        proxy_http_version 1.1;

        # Preserve the original request information.
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Internal authentication between Nginx and Flask.
        # This secret is never exposed to the browser.
        proxy_set_header X-PingMe-Proxy-Token ${NGINX_PROXY_TOKEN};

        # Required when the upstream backend uses HTTPS.
        # These settings are harmless for the local HTTP upstream.
        proxy_ssl_server_name on;
        proxy_ssl_name ${BACKEND_HOST};

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}